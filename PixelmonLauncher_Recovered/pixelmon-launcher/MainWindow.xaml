<Window x:Class="PixelmonLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pixelmon Launcher"
        Width="392"
        Height="476"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="TextMain" Color="#293241" />
        <SolidColorBrush x:Key="TextSoft" Color="#5A6678" />

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="BorderBrush" Value="#74C8D2E4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E8FFFFFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A6B6C2D4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#CFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,0,10,0" />
            <Setter Property="Background" Value="#DFFFFFFF" />
            <Setter Property="BorderBrush" Value="#8EB8C3D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="CaretBrush" Value="#1F2937" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#9B60A5FA" />
                                <Setter TargetName="Border" Property="Background" Value="#F4FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FolderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="BorderBrush" Value="#82B8C3D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#ECFFFFFF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#A6A8B8CF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D9FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LaunchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="314" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="14" ClipToBounds="True" Opacity="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#70B9F0" Offset="0" />
                                    <GradientStop Color="#7E5EF1" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#A8F6F8FC" ClipToBounds="True">
        <Grid Clip="M0,14 Q0,0 14,0 H378 Q392,0 392,14 V462 Q392,476 378,476 H14 Q0,476 0,462 Z">
            <Image Source="Assets/Images/launcher-cutout.png"
                   Width="300" Height="300"
                   Stretch="Uniform"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,88"
                   Opacity="0.48">
                <Image.Effect>
                    <DropShadowEffect Color="#6B7280" BlurRadius="18" ShadowDepth="0" Opacity="0.18" />
                </Image.Effect>
            </Image>

            <Border CornerRadius="14" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#78FFFFFF" Offset="0" />
                        <GradientStop Color="#48F6F8FF" Offset="0.45" />
                        <GradientStop Color="#68E9EFF8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,6,7,0"
                            MouseLeftButtonDown="WindowDragArea_OnMouseLeftButtonDown">
                    <Button Style="{StaticResource WindowButtonStyle}"
                            Content="−"
                            Click="MinimizeButton_OnClick"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource WindowButtonStyle}"
                            Content="×"
                            Click="CloseButton_OnClick" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="38,0,38,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Image Source="Assets/Images/pixelmon-logo-hq-cutout.png"
                               Width="58" Height="58" Stretch="Uniform" HorizontalAlignment="Center" />
                        <TextBlock Text="P I X E L M O N"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#293241"
                                   FontWeight="Bold"
                                   FontSize="22" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="L A U N C H E R"
                               HorizontalAlignment="Center"
                               Foreground="#5A6678"
                               FontWeight="Medium"
                               FontSize="11" />

                    <TextBox x:Name="NicknameBox"
                             Grid.Row="3"
                             MaxLength="16"
                             Style="{StaticResource LauncherTextBoxStyle}" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1"
                                   Text="Mon-1.21.1"
                                   VerticalAlignment="Center"
                                   Foreground="#1F2937"
                                   FontSize="13"
                                   FontWeight="Medium" />
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource FolderButtonStyle}"
                                Click="OpenModsButton_OnClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="▣" FontSize="14" Foreground="#475569" />
                                <TextBlock Text="Mods" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource FolderButtonStyle}"
                                Click="OpenShaderpacksButton_OnClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="◈" FontSize="14" Foreground="#475569" />
                                <TextBlock Text="Shaders" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Button x:Name="LaunchButton"
                            Grid.Row="8"
                            Style="{StaticResource LaunchButtonStyle}"
                            Click="LaunchButton_OnClick"
                            PreviewMouseLeftButtonDown="LaunchButton_OnPreviewMouseLeftButtonDown">
                        <Grid Width="314" Height="54" ClipToBounds="True">
                            <Border x:Name="LaunchProgressFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Opacity="0.58">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#B9E2FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="LaunchIcon"
                                      Width="18" Height="20"
                                      Margin="0,1,14,0"
                                      Fill="#FFFFFF"
                                      Stretch="Uniform"
                                      Data="M 2,1 L 17,10 L 2,19 Z" />
                                <TextBlock x:Name="LaunchButtonText"
                                           Text="게임 시작"
                                           Foreground="#FFFFFF"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock x:Name="StatusText"
                               Grid.Row="9"
                               Margin="0,13,0,0"
                               Text="Ready"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="Medium"
                               TextAlignment="Center" />
                </Grid>
            </Grid>

            <Border BorderBrush="#B8D3DAE8"
                    BorderThickness="1"
                    CornerRadius="13"
                    IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
